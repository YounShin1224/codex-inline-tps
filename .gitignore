# Publish only the reviewed source manifest. Everything else is local by default.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/SECURITY.md
!/LICENSE
!/package.json
!/package-lock.json
!/plugins/
/plugins/*
!/plugins/codex-tps/
/plugins/codex-tps/*
!/plugins/codex-tps/plugin.json
!/plugins/codex-tps/README.md
!/plugins/codex-tps/mcp.json
!/plugins/codex-tps/server.mjs
!/plugins/codex-tps/session-store.mjs
!/plugins/codex-tps/entry.mjs
!/plugins/codex-tps/panel.mjs
!/plugins/codex-tps/panel.html
!/.agents/
/.agents/*
!/.agents/plugins/
/.agents/plugins/*
!/.agents/plugins/marketplace.json
!/scripts/
/scripts/*
!/scripts/build-plugin.mjs
!/scripts/package-plugin.mjs
!/metrics.mjs
!/renderer.js
!/cdp.mjs
!/main.mjs
!/start.ps1
!/stop.ps1
!/启动 Codex TPS.vbs
!/停止 Codex TPS.vbs
!/test/
/test/*
!/test/metrics.test.mjs
!/test/browser.test.mjs
!/test/plugin.test.mjs
!/test/plugin.browser.test.mjs

# Explicitly document sensitive local state even though the allowlist already excludes it.
/.runtime/
/.env*
*.log
*.sqlite*
*.pem
*.key
node_modules/
